{
  "log": {
    "loglevel": "warning"
  },
{% if proxy_control_plane_runtime_api_enabled | bool %}
  "api": {
    "tag": "{{ proxy_control_plane_runtime_api_tag }}",
    "services": [
      "HandlerService",
      "StatsService"
    ]
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    }
  },
{% endif %}
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
{% if proxy_control_plane_runtime_api_enabled | bool %}
      {
        "type": "field",
        "inboundTag": [
          "{{ proxy_control_plane_runtime_api_tag }}"
        ],
        "outboundTag": "{{ proxy_control_plane_runtime_api_tag }}"
      },
{% endif %}
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "direct"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "{{ proxy_control_plane_runtime_inbound_tag }}",
      "port": {{ xray_under_caddy_internal_port | default(10010) | int }},
      "protocol": "vless",
      "settings": {
        "clients": {{ xray_under_caddy_static_clients | default([]) | to_json }},
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "{{ xray_under_caddy_ws_path | default('/v2ray') }}"
        }
      }
    }{% if proxy_control_plane_runtime_api_enabled | bool %},
    {
      "tag": "{{ proxy_control_plane_runtime_api_tag }}",
      "listen": "0.0.0.0",
      "port": {{ proxy_control_plane_xray_under_caddy_runtime_api_port | int }},
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      }
    }{% endif %}
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "blocked"
    }
  ]
}
