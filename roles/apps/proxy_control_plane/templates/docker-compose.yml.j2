name: proxy-control-plane

services:
  api:
    image: "{{ proxy_control_plane_image }}"
    container_name: "{{ proxy_control_plane_container_name }}"
    restart: unless-stopped
    env_file:
      - ./app.env
    ports:
      - "{{ proxy_control_plane_bind_host }}:{{ proxy_control_plane_host_port | int }}:{{ proxy_control_plane_container_port | int }}"
