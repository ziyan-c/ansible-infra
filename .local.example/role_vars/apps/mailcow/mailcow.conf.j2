# Example only. For production, start from Mailcow's generated mailcow.conf and
# keep the completed private version under .local/role_vars/apps/mailcow/mailcow.conf.j2.
MAILCOW_HOSTNAME=mail.{{ base_domain }}
MAILCOW_PASS_SCHEME=BLF-CRYPT
TZ={{ system_timezone }}
SKIP_LETS_ENCRYPT=y
SKIP_CLAMD=n
SKIP_SOLR=n
API_KEY=REPLACE_ME_MAILCOW_API_KEY
API_KEY_READ_ONLY=REPLACE_ME_MAILCOW_READONLY_API_KEY
