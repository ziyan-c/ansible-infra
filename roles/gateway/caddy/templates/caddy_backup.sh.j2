#!/bin/bash
set -euo pipefail
# ==========================================
# Caddy site 自动化备份脚本 (保留 /opt/caddy/site 路径层级)
# ==========================================

export PATH="${ANSIBLE_INFRA_SCRIPT_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"

# --- 1. 配置变量 ---
ROLE_NAME="caddy"
TARGET_DIR="${CADDY_TARGET_DIR:-/opt/caddy}"
BACKUP_SUBDIR="${CADDY_BACKUP_SUBDIR:-site}"
BACKUP_ROOT="${CADDY_BACKUP_ROOT:-/opt/caddy_backups}"
GDRIVE_REMOTE="gdrive:AUTO_BACKUPS/${ROLE_NAME}/{{ inventory_hostname }}"

# 👇 引入 Ansible 全局变量
KEEP_LOCAL={{ backup_keep_local }}
KEEP_REMOTE={{ backup_keep_remote }}

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
TAR_FILE="caddy_backup_${TIMESTAMP}.tar.gz"
BACKUP_PATH="$TARGET_DIR/$BACKUP_SUBDIR"

cleanup_local_backups() {
    find "$BACKUP_ROOT" -maxdepth 1 -type f -name 'caddy_backup_*.tar.gz' -printf '%T@ %p\n' \
        | sort -rn \
        | tail -n +$((KEEP_LOCAL + 1)) \
        | cut -d' ' -f2- \
        | while IFS= read -r filename; do
            [ -n "$filename" ] && rm -f -- "$filename"
        done
}

cleanup_remote_backups() {
    rclone lsf "$GDRIVE_REMOTE" --files-only \
        | awk '/^caddy_backup_/ { print }' \
        | sort \
        | head -n -"${KEEP_REMOTE}" \
        | while IFS= read -r filename; do
            if [ -n "$filename" ]; then
                rclone deletefile "$GDRIVE_REMOTE/$filename"
                echo "[$TIMESTAMP] 已清理远端备份: $filename"
            fi
        done
}

# --- 2. 压缩打包 ---
mkdir -p "$BACKUP_ROOT"
echo "[$TIMESTAMP] 开始打包 Caddy site 目录 ($BACKUP_PATH) ..."

if [ ! -d "$BACKUP_PATH" ]; then
    echo "[$TIMESTAMP] 🚨 Caddy site 目录不存在: $BACKUP_PATH"
    exit 1
fi

# 只备份 /opt/caddy/site，但保留归档内的 caddy/site/... 层级。
if tar -czf "$BACKUP_ROOT/$TAR_FILE" \
    -C "$(dirname "$TARGET_DIR")" "$(basename "$TARGET_DIR")/$BACKUP_SUBDIR"; then
    if [ -s "$BACKUP_ROOT/$TAR_FILE" ]; then
        echo "[$TIMESTAMP] 打包成功: $TAR_FILE"
    else
        echo "[$TIMESTAMP] 🚨 打包结果为空！"
        exit 1
    fi
else
    echo "[$TIMESTAMP] 🚨 打包失败！"
    exit 1
fi

# --- 3. 上传到 Google Drive ---
echo "[$TIMESTAMP] 正在上传至 Google Drive ($GDRIVE_REMOTE) ..."
rclone copy "$BACKUP_ROOT/$TAR_FILE" "$GDRIVE_REMOTE"

# --- 4. 清理本地旧备份 (仅保留 KEEP_LOCAL 份) ---
cleanup_local_backups

# --- 5. 清理远端旧备份 (保留 KEEP_REMOTE 份) ---
cleanup_remote_backups

echo "[$TIMESTAMP] Caddy 备份与清理流程结束。"
