{% set neo_wg_node = wg_servers.values() | selectattr('hostname', 'equalto', inventory_hostname) | first %}
{% set neo_wg_bind_ip = neo_backend_wireguard_bind_ip | default('', true) %}
{% if not neo_wg_bind_ip and neo_wg_node %}
{% set neo_wg_bind_ip = wg_network_prefix ~ '.' ~ neo_wg_node.ip_suffix %}
{% endif %}
services:
  neo-backend:
    build:
      context: ./app
    image: "{{ neo_backend_image }}"
    container_name: "{{ neo_backend_container_name }}"
    restart: unless-stopped
    env_file:
      - .env
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% for name, srv in wg_servers.items() %}
      - "{{ srv.hostname.split('.')[0] }}:{{ wg_network_prefix }}.{{ srv.ip_suffix }}"
{% endfor %}
    networks:
      - web-proxy
    expose:
      - "{{ neo_rag_proxy_port }}"
      - "{{ neo_llm_proxy_port }}"
{% if neo_backend_publish_wireguard | default(true) | bool %}
    ports:
      - "{{ neo_wg_bind_ip }}:{{ neo_rag_proxy_port }}:{{ neo_rag_proxy_port }}"
      - "{{ neo_wg_bind_ip }}:{{ neo_llm_proxy_port }}:{{ neo_llm_proxy_port }}"
{% endif %}
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ neo_rag_proxy_port }}/health', timeout=5)"
      interval: 30s
      timeout: 10s
      retries: 3

networks:
  web-proxy:
    external: true
