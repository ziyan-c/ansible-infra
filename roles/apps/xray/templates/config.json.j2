{
    "log": {
        "loglevel": "warning"
    },
{% if proxy_control_plane_runtime_api_enabled | bool %}
    "api": {
        "tag": "{{ proxy_control_plane_runtime_api_tag }}",
        "services": [
            "HandlerService",
            "StatsService"
        ]
    },
    "stats": {},
    "policy": {
        "levels": {
            "0": {
                "statsUserUplink": true,
                "statsUserDownlink": true
            }
        }
    },
{% endif %}
    "routing": {
        "domainStrategy": "AsIs",
        "rules": [
{% if proxy_control_plane_runtime_api_enabled | bool %}
            {
                "type": "field",
                "inboundTag": [
                    "{{ proxy_control_plane_runtime_api_tag }}"
                ],
                "outboundTag": "{{ proxy_control_plane_runtime_api_tag }}"
            },
{% endif %}
            {
                "type": "field",
                "ip": [
                    "geoip:private"
                ],
                "outboundTag": "blocked"
            },
            {
                "type": "field",
                "network": "tcp,udp",
                "outboundTag": "direct"
            }
        ]
    },
    "inbounds": [
        {
            "tag": "{{ proxy_control_plane_runtime_inbound_tag }}",
            "port": 443,
            "protocol": "vless",
            "settings": {
                "clients": {{ xray_static_clients | default([]) | to_json }},
                "decryption": "none"
            },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "dest": "{{ xray_reality_dest }}",
                    "xver": 0,
                    "serverNames": {{ xray_reality_server_names | to_json }},
                    "privateKey": "{{ xray_private_key }}",
                    "shortIds": {{ xray_reality_short_ids | to_json }}
                }
            }
        }{% if proxy_control_plane_runtime_api_enabled | bool %},
        {
            "tag": "{{ proxy_control_plane_runtime_api_tag }}",
            "listen": "0.0.0.0",
            "port": {{ proxy_control_plane_xray_runtime_api_port | int }},
            "protocol": "dokodemo-door",
            "settings": {
                "address": "127.0.0.1"
            }
        }{% endif %}
    ],
    "outbounds": [
        {
            "protocol": "freedom",
            "tag": "direct"
        },
        {
            "protocol": "blackhole",
            "tag": "blocked"
        }
    ]
}
