  {% endif %}
{% endfor %} #}
# 直接从 wg_servers 中筛选出 hostname 等于当前机器名字的那一项
{% set my_node_item = wg_servers | dict2items | selectattr('value.hostname', 'equalto', inventory_hostname) | first %}
{% set my_name = my_node_item.key %}
{% set my_node = my_node_item.value %}
{% set wg_psks = wg_preshared_keys | default({}) %}
{% set wg_server_psks = wg_psks.server_pairs | default({}) %}
{% set wg_client_psks = wg_psks.client_pairs | default({}) %}

[Interface]
# 本机分配的内网 IP
Address = {{ wg_network_prefix }}.{{ my_node.ip_suffix }}/24
ListenPort = {{ wg_port }}
PrivateKey = {{ my_node.priv }}

# 开启 NAT 转发，强行插入规则到最顶部 (-I) 绕过 Firewalld 拦截，并允许一来一回的双向流量
# 👇 在最后追加了 -o wg0 -j MASQUERADE 规则，解决内网跳板访问问题
PostUp = iptables -I FORWARD -i wg0 -j ACCEPT; iptables -I FORWARD -o wg0 -j ACCEPT; iptables -t nat -I POSTROUTING -o {{ ansible_facts.default_ipv4.interface }} -j MASQUERADE; iptables -t nat -I POSTROUTING -o wg0 -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o {{ ansible_facts.default_ipv4.interface }} -j MASQUERADE; iptables -t nat -D POSTROUTING -o wg0 -j MASQUERADE

# ===============================================
# 服务器互联 (Full Mesh)
# ===============================================
{% for name, peer in wg_servers.items() %}
{% if peer.hostname != inventory_hostname %}
{% set pair_names = [my_name, name] | sort %}
{% set psk_key = pair_names[0] ~ '__' ~ pair_names[1] %}
{% set psk = wg_server_psks[psk_key] | default('') %}
[Peer]
# Server: {{ peer.hostname }}
PublicKey = {{ peer.pub }}
{% if psk | length > 0 %}
PresharedKey = {{ psk }}
{% endif %}
Endpoint = {{ peer.endpoint }}:{{ wg_port }}
# 核心逻辑：服务器之间只允许内网 IP 互通，不互相代理外网流量
AllowedIPs = {{ wg_network_prefix }}.{{ peer.ip_suffix }}/32  # <-- ✅ 改成这样
PersistentKeepalive = 25
{% endif %}
{% endfor %}

# ===============================================
# 个人设备客户端
# ===============================================
{% for name, client in wg_clients.items() %}
{% set psk_key = name ~ '__' ~ my_name %}
{% set psk = wg_client_psks[psk_key] | default('') %}
[Peer]
# Client: {{ name }}
PublicKey = {{ client.pub }}
{% if psk | length > 0 %}
PresharedKey = {{ psk }}
{% endif %}
# 允许客户端的 IP 连入
AllowedIPs = {{ wg_network_prefix }}.{{ client.ip_suffix }}/32  # <-- ✅ 改成 client
{% endfor %}
