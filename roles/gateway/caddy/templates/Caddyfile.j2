{% macro proxy_control_plane_subscription_routes() %}
{% if proxy_control_plane_subscription_proxy_enabled | default(false) | bool %}
    handle_path {{ proxy_control_plane_subscription_public_path | default('/xray/sub') }}/* {
        rewrite * /sub{uri}
        reverse_proxy {{ proxy_control_plane_subscription_proxy_upstream | default(proxy_control_plane_api_url | default('http://127.0.0.1:9710')) }} {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
{% endif %}
{% endmacro %}

# ==========================================
# 动态判定：如果当前机器被分配为 Xray under Caddy 节点，则渲染主站代理
# ==========================================
{% if inventory_hostname == deploy_node_xray_under_caddy %}

{{ base_domain }} {
    tls /etc/caddy/certs/cloudflare/server.crt /etc/caddy/certs/cloudflare/server.key
    root * /usr/share/caddy

    header {
        Access-Control-Allow-Origin "https://{{ base_domain }}"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Origin, Content-Type, Accept, Authorization"
        Access-Control-Max-Age "3600"
    }

    handle_path /sharing-protected* {
        root * /usr/share/caddy/sharing-protected
        file_server browse
        basic_auth {
            {{ caddy_basic_auth_hash }}
        }
    }

{{ proxy_control_plane_subscription_routes() }}

    file_server
}

{{ xray_under_caddy_domain }} {
    tls /etc/caddy/certs/cloudflare/server.crt /etc/caddy/certs/cloudflare/server.key
    root * /usr/share/caddy

    handle {{ xray_under_caddy_ws_path | default('/v2ray') }} {
        reverse_proxy xray-under-caddy:10010 {
            header_up X-Real-IP {header.CF-Connecting-IP}
            header_up X-Forwarded-For {header.CF-Connecting-IP}
        }
    }

    file_server
}
{% endif %}

# ==========================================
# 动态判定：如果当前机器被分配为 Zammad 节点，则渲染工单代理
# ==========================================
{% if (zammad_enabled | default(true) | bool) and inventory_hostname == deploy_node_zammad %}

support.{{ base_domain }} {
    tls /etc/caddy/certs/cloudflare/server.crt /etc/caddy/certs/cloudflare/server.key
    root * /usr/share/caddy
    file_server

    reverse_proxy zammad-nginx:8080 {
        header_up Origin {header.Origin}
        header_up Host {host}
        header_up X-Real-IP {header.CF-Connecting-IP}
        header_up X-Forwarded-For {header.CF-Connecting-IP}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Port 443
        header_up X-Forwarded-Ssl on
    }
}
{% endif %}
