services:
  neo-backend:
    build:
      context: ./app
    image: "{{ neo_backend_image }}"
    container_name: "{{ neo_backend_container_name }}"
    restart: unless-stopped
    env_file:
      - .env
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% for name, srv in wg_servers.items() %}
      - "{{ srv.hostname.split('.')[0] }}:{{ wg_network_prefix }}.{{ srv.ip_suffix }}"
{% endfor %}
    networks:
      - web-proxy
    expose:
      - "{{ neo_rag_proxy_port }}"
      - "{{ neo_llm_proxy_port }}"
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ neo_rag_proxy_port }}/health', timeout=5)"
      interval: 30s
      timeout: 10s
      retries: 3

networks:
  web-proxy:
    external: true
