# 动态提取当前主机的身份信息
# ===============================================
{# {% set my_node = none %}
{% for name, srv in wg_servers.items() %}
  {% if srv.hostname == inventory_hostname %}
    {% set my_node = srv %}
  {% endif %}
{% endfor %} #}
# 直接从 wg_servers 中筛选出 hostname 等于当前机器名字的那一项
{% set my_node_item = wg_servers | dict2items | selectattr('value.hostname', 'equalto', inventory_hostname) | first %}
{% set my_name = my_node_item.key %}
{% set my_node = my_node_item.value %}
{% set wg_psks = wg_preshared_keys | default({}) %}
{% set wg_server_psks = wg_psks.server_pairs | default({}) %}
{% set wg_client_psks = wg_psks.client_pairs | default({}) %}
{% set wg_spoke_psks = wg_psks.spoke_pairs | default({}) %}
{% set wg_spoke_nodes = wg_spoke_nodes | default({}) %}
{% set wg_restricted_is_enabled = wg_restricted_enabled | default(false) %}
{% set wg_restricted_hub_name = wg_restricted_hub | default('') %}
{% set wg_restricted_cidr = wg_restricted_network_cidr | default('') %}
{% set wg_restricted_firewall_hook = wg_restricted_firewall_script_path | default('/usr/local/sbin/wg-restricted-firewall') %}
{% set wg_restricted_firewall_postup = '; test ! -x ' ~ wg_restricted_firewall_hook ~ ' || ' ~ wg_restricted_firewall_hook ~ ' up' if (wg_restricted_is_enabled | bool and wg_restricted_hub_name == my_name) else '' %}

[Interface]
# 本机分配的内网 IP
Address = {{ wg_network_prefix }}.{{ my_node.ip_suffix }}/24
ListenPort = {{ wg_port }}
PrivateKey = {{ my_node.priv }}

# 开启 NAT 转发，强行插入规则到最顶部 (-I) 绕过 Firewalld 拦截，并允许一来一回的双向流量
# 👇 在最后追加了 -o wg0 -j MASQUERADE 规则，解决内网跳板访问问题
PostUp = iptables -I FORWARD -i wg0 -j ACCEPT; iptables -I FORWARD -o wg0 -j ACCEPT; iptables -t nat -I POSTROUTING -o {{ ansible_facts.default_ipv4.interface }} -j MASQUERADE; iptables -t nat -I POSTROUTING -o wg0 -j MASQUERADE{{ wg_restricted_firewall_postup }}
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o {{ ansible_facts.default_ipv4.interface }} -j MASQUERADE; iptables -t nat -D POSTROUTING -o wg0 -j MASQUERADE

# ===============================================
# 服务器互联 (Full Mesh)
# ===============================================
{% for name, peer in wg_servers.items() %}
{% if peer.hostname != inventory_hostname %}
{% set pair_names = [my_name, name] | sort %}
{% set psk_key = pair_names[0] ~ '__' ~ pair_names[1] %}
{% set psk = wg_server_psks[psk_key] | default('') %}
{% set peer_allowed_ips = namespace(values=[wg_network_prefix ~ '.' ~ peer.ip_suffix ~ '/32']) %}
{% for spoke_name, spoke in wg_spoke_nodes.items() %}
{% if spoke.hub == name %}
{% set peer_allowed_ips.values = peer_allowed_ips.values + [wg_network_prefix ~ '.' ~ spoke.ip_suffix ~ '/32'] %}
{% endif %}
{% endfor %}
{% if wg_restricted_is_enabled | bool and wg_restricted_hub_name == name and wg_restricted_cidr | length > 0 %}
{% set peer_allowed_ips.values = peer_allowed_ips.values + [wg_restricted_cidr] %}
{% endif %}
[Peer]
# Server: {{ peer.hostname }}
PublicKey = {{ peer.pub }}
{% if psk | length > 0 %}
PresharedKey = {{ psk }}
{% endif %}
{% if peer.endpoint | default('') | length > 0 %}
Endpoint = {{ peer.endpoint }}:{{ wg_port }}
{% endif %}
# 核心逻辑：服务器之间只允许内网 IP 互通，不互相代理外网流量
AllowedIPs = {{ peer_allowed_ips.values | join(', ') }}  # <-- ✅ 改成这样
{% if (peer.persistent_keepalive | default(0) | int) > 0 %}
PersistentKeepalive = {{ peer.persistent_keepalive | int }}
{% endif %}
{% endif %}
{% endfor %}

{% set spoke_section = namespace(rendered=false) %}
{% for name, spoke in wg_spoke_nodes.items() %}
{% if spoke.hub == my_name %}
{% if not spoke_section.rendered %}
# ===============================================
# Hub-Spoke 节点 (例如无公网 IP 的 Homelab)
# ===============================================
{% set spoke_section.rendered = true %}
{% endif %}
{% set psk_key = name ~ '__' ~ my_name %}
{% set psk = wg_spoke_psks[psk_key] | default('') %}
[Peer]
# Spoke: {{ name }} via this hub
PublicKey = {{ spoke.pub }}
{% if psk | length > 0 %}
PresharedKey = {{ psk }}
{% endif %}
{% if spoke.endpoint | default('') | length > 0 %}
Endpoint = {{ spoke.endpoint }}:{{ spoke.port | default(wg_port) }}
{% endif %}
AllowedIPs = {{ wg_network_prefix }}.{{ spoke.ip_suffix }}/32
{% if (spoke.hub_persistent_keepalive | default(0) | int) > 0 %}
PersistentKeepalive = {{ spoke.hub_persistent_keepalive | int }}
{% endif %}
{% endif %}
{% endfor %}

# ===============================================
# 个人设备客户端
# ===============================================
{% for name, client in wg_clients.items() %}
{% set psk_key = name ~ '__' ~ my_name %}
{% set psk = wg_client_psks[psk_key] | default('') %}
[Peer]
# Client: {{ name }}
PublicKey = {{ client.pub }}
{% if psk | length > 0 %}
PresharedKey = {{ psk }}
{% endif %}
# 允许客户端的 IP 连入
AllowedIPs = {{ wg_network_prefix }}.{{ client.ip_suffix }}/32  # <-- ✅ 改成 client
{% endfor %}
