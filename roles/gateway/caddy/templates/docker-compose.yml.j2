{% set logto_admin_uses_certbot_tls = (
  (logto_admin_proxy_enabled | default(false) | bool) and
  (logto_admin_domain | default('') | length > 0) and
  ((logto_admin_tls_provider | default('cloudflare')) == 'certbot') and
  (inventory_hostname == (deploy_node_logto_gateway | default('')))
) %}
{% set sftpgo_admin_uses_certbot_tls = (
  (sftpgo_admin_proxy_enabled | default(false) | bool) and
  (sftpgo_admin_domain | default('') | length > 0) and
  ((sftpgo_admin_tls_provider | default('cloudflare')) == 'certbot') and
  (inventory_hostname == (deploy_node_sftpgo_gateway | default('')))
) %}
services:
  caddy:
    image: "{{ caddy_image }}"
    container_name: caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      # 直接挂载本目录下的 certs 文件夹
      - ./certs:/etc/caddy/certs:ro
{% if logto_admin_uses_certbot_tls or sftpgo_admin_uses_certbot_tls %}
      - "{{ caddy_letsencrypt_live_dir | default('/etc/letsencrypt/live') }}:/etc/letsencrypt/live:ro"
      - "{{ caddy_letsencrypt_archive_dir | default('/etc/letsencrypt/archive') }}:/etc/letsencrypt/archive:ro"
{% endif %}
      - ./data:/data
      - ./config:/config
      - ./site:/usr/share/caddy
    networks:
      - web-proxy

networks:
  web-proxy:
    external: true
