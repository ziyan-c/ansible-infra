#!/bin/bash
set -euo pipefail
# ==========================================
# PostgreSQL 自动化备份脚本 (数据库 + 物理文件)
# ==========================================

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# --- 1. 配置变量 ---
ROLE_NAME="postgres"
CONTAINER_NAME="postgres"
BACKUP_DIR="/opt/${ROLE_NAME}_backups"
GDRIVE_REMOTE="gdrive:AUTO_BACKUPS/${ROLE_NAME}" 

# 👇 引入 Ansible 全局变量
KEEP_LOCAL={{ backup_keep_local }}
KEEP_REMOTE={{ backup_keep_remote }}

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")

# 备份文件名
SQL_BACKUP="pg_sql_$TIMESTAMP.sql.gz"
DATA_BACKUP="pg_custom_data_$TIMESTAMP.tar.gz"

DB_USER="{{ pg_user }}"
DB_PASS="{{ pg_admin_password | default(pg_password) }}"
CUSTOM_DATA_DIR="{{ pg_custom_dir }}"

cleanup_local_backups() {
    local pattern="$1"
    find "$BACKUP_DIR" -maxdepth 1 -type f -name "$pattern" -printf '%T@ %p\n' \
        | sort -rn \
        | tail -n +$((KEEP_LOCAL + 1)) \
        | cut -d' ' -f2- \
        | while IFS= read -r filename; do
            [ -n "$filename" ] && rm -f -- "$filename"
        done
}

cleanup_remote_backups() {
    local prefix="$1"
    local label="$2"

    rclone lsf "$GDRIVE_REMOTE" --files-only \
        | awk -v prefix="$prefix" 'index($0, prefix) == 1 { print }' \
        | sort \
        | head -n -"${KEEP_REMOTE}" \
        | while IFS= read -r filename; do
            if [ -n "$filename" ]; then
                rclone deletefile "$GDRIVE_REMOTE/$filename"
                echo "[$TIMESTAMP] 已清理远端${label}备份: $filename"
            fi
        done
}

# --- 2. 执行全库 SQL 备份 ---
mkdir -p "$BACKUP_DIR"
echo "[$TIMESTAMP] 正在导出数据库 SQL..."
if ! docker exec -i -e PGPASSWORD="$DB_PASS" "$CONTAINER_NAME" \
    pg_dumpall -U "$DB_USER" | gzip > "$BACKUP_DIR/$SQL_BACKUP"; then
    rm -f "$BACKUP_DIR/$SQL_BACKUP"
    echo "[$TIMESTAMP] 🚨 SQL 备份失败，中止流程！"
    exit 1
fi

if [ ! -s "$BACKUP_DIR/$SQL_BACKUP" ]; then
    rm -f "$BACKUP_DIR/$SQL_BACKUP"
    echo "[$TIMESTAMP] 🚨 SQL 备份为空，中止流程！"
    exit 1
fi

# --- 3. 执行 Custom Data 文件夹备份 (新增) ---
if [ -d "$CUSTOM_DATA_DIR" ]; then
    echo "[$TIMESTAMP] 正在打包自定义文件夹 ($CUSTOM_DATA_DIR)..."
    # 使用 -C 切换目录防止 tar 包里出现多层深路径
    tar -czf "$BACKUP_DIR/$DATA_BACKUP" -C "$(dirname "$CUSTOM_DATA_DIR")" "$(basename "$CUSTOM_DATA_DIR")"
else
    echo "[$TIMESTAMP] 跳过文件夹备份，路径不存在: $CUSTOM_DATA_DIR"
fi

# --- 4. 检查结果并上传 ---
echo "[$TIMESTAMP] 备份生成成功，正在同步至云端..."
rclone copy "$BACKUP_DIR/" "$GDRIVE_REMOTE" --include "pg_*_$TIMESTAMP.*"

# --- 5. 清理本地与远端旧备份 (分片清理，防止字母排序灾难) ---

# 1. 本地清理 (严格分开)
cleanup_local_backups 'pg_sql_*.sql.gz'
cleanup_local_backups 'pg_custom_data_*.tar.gz'

# 2. 远端清理 SQL 备份
cleanup_remote_backups 'pg_sql_' ' SQL'

# 3. 远端清理 Custom Data 备份
cleanup_remote_backups 'pg_custom_data_' '数据'

echo "[$TIMESTAMP] Postgres 全量灾备完成。"
